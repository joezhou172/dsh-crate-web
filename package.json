{
  "name": "dsh-crate-web",
  "description": "DSH Web Settings surface for DSH Crate export, import, inspect, and history",
  "version": "0.1.2-preview.10",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/*.d.ts",
    "restart-helper.mjs",
    "verify-desktop.mjs",
    "desktop-patch-helper.mjs",
    "merge-config.mjs",
    "cordis.patch.yml",
    "core/dsh_pack/**/*.py",
    "runtime/python",
    "skills/dsh-crate-troubleshooting/SKILL.md",
    "skills/dsh-crate-troubleshooting/compatibility.json",
    "skills/dsh-crate-troubleshooting/reference/*.md",
    "THIRD-PARTY-LICENSE.txt",
    "runtime-inventory.mjs",
    "packaging/windows-terminal/build.py",
    "packaging/windows-terminal/manifest.json",
    "packaging/windows-terminal/README.md",
    "packaging/windows-terminal/*.patch"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "preview"
  },
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "node scripts/vendor-core.mjs && node scripts/prepare-runtime.mjs && tsdown"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-connection": "*",
    "@deepseek-ai/cordis": "^4.0.0",
    "@deepseek-ai/dsh-client-locale": "*",
    "@deepseek-ai/dsh-client-runtime": "*",
    "@deepseek-ai/dsh-client-ui-settings": "*",
    "@deepseek-ai/dsh-client-ui-slots": "*",
    "@deepseek-ai/dsh-host-webserver": "*",
    "react": "^18.2.0",
    "@deepseek-ai/dsh-client-ui-primitives": "*"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "crate",
    "pack",
    "profile",
    "export",
    "import",
    "backup",
    "restore",
    "plugin"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joezhou172/dsh-crate-web.git"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-connection": {
      "optional": true
    },
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-locale": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-runtime": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-settings": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-slots": {
      "optional": true
    },
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-primitives": {
      "optional": true
    }
  }
}
